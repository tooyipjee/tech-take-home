{
  "name": "internal-tool-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": { "node": ">=20" },
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "tsx packages/db/src/cli.ts migrate",
    "db:seed": "tsx packages/db/src/cli.ts seed",
    "db:reset": "tsx packages/db/src/cli.ts reset",
    "setup": "npm run db:up && node scripts/wait-for-db.mjs && npm run db:reset",
    "dev": "concurrently -n api,console,refunds,queue,kyc -c cyan,magenta,green,blue,yellow \"npm:dev:api\" \"npm:dev:console\" \"npm:dev:refunds\" \"npm:dev:queue\" \"npm:dev:kyc\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:console": "vite --config apps/console/vite.config.ts",
    "dev:refunds": "vite --config apps/refunds/vite.config.ts",
    "dev:queue": "vite --config apps/review-queue/vite.config.ts",
    "dev:kyc": "vite --config apps/kyc-review/vite.config.ts",
    "build:console": "vite build --config apps/console/vite.config.ts",
    "build:refunds": "vite build --config apps/refunds/vite.config.ts",
    "build:queue": "vite build --config apps/review-queue/vite.config.ts",
    "build:kyc": "vite build --config apps/kyc-review/vite.config.ts",
    "build:apps": "npm run build:console && npm run build:refunds && npm run build:queue && npm run build:kyc",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-boundaries.mjs && node scripts/check-tier.mjs",
    "test": "tsx --test packages/kernel/test/*.test.ts",
    "test:db": "tsx --test packages/kernel/test/db/*.test.ts",
    "reconcile": "tsx apps/api/src/reconcile.ts"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/pg": "8.11.6",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "concurrently": "8.2.2",
    "tsx": "4.16.2",
    "typescript": "5.5.3",
    "vite": "5.3.4"
  },
  "dependencies": {
    "@fastify/cors": "9.0.1",
    "fastify": "4.28.1",
    "pg": "8.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.23.8"
  }
}
